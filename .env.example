# ===================================================
# Greater Grace Embassy Church International (GGECI)
# Production Environment Variables Template
# Copy this file to .env and set your production values
# DO NOT commit real secrets or .env to version control
# ===================================================

# Application Server
PORT=3000
NODE_ENV=production
APP_URL=https://www.ggeci.com


# Database Configuration (Optional Cloud Database Adapter)
# If left unset, GGECI runs on local resilient JSON persistence in data/
DATABASE_URL=
MONGODB_URI=

# Payment Gateway (Paystack / Flutterwave)
# Nigeria & International Online Giving Integration
# Public key is used in frontend JavaScript for secure checkout popups
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret key is ONLY used on the serverless backend - NEVER exposed to browser
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
# Optional Flutterwave credentials
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Email Service (SendGrid / Mailgun / Resend)
# Used for church notifications, newsletter dispatch, and booking alerts
EMAIL_SERVICE_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=office@ggeci.com
EMAIL_ADMIN_NOTIFICATIONS=pastor@ggeci.com

# Cloud File & Media Storage (Cloudinary / AWS S3)
# For audio sermons, event flyers, and bulletin uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
